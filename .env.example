# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Google Sheets — service account JSON as a string or file path.
# Option 1 (recommended): use a file path when credentials are multi-line.
# GOOGLE_SHEETS_CREDENTIALS=service_account.json
# Option 2: paste the JSON inline (must be single line).
GOOGLE_SHEETS_CREDENTIALS={"type":"service_account","project_id":"..."}

# Google Sheets ID (from the URL: docs.google.com/spreadsheets/d/{SPREADSHEET_ID}/edit)
SPREADSHEET_ID=your_spreadsheet_id_here

APP_ENV=development
